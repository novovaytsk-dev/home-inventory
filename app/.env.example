# ============================================
# Настройки базы данных PostgreSQL
# ============================================
DATABASE_URL=postgresql+asyncpg://inventory_user:inventory_pass@localhost:5432/home_inventory

# Для синхронных операций (Alembic использует синхронный драйвер)
SYNC_DATABASE_URL=postgresql://inventory_user:inventory_pass@localhost:5432/home_inventory

# ============================================
# Redis (для кеширования и Celery)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# JWT настройки
# ============================================
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Настройки срока годности (по умолчанию)
# ============================================
EXPIRING_SOON_DAYS=3

# ============================================
# Celery (опционально)
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2